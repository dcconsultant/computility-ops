# computility-ops docker compose env template
# 复制为 .env 后再执行 ./deploy.sh

# storage driver: mysql | memory
STORAGE_DRIVER=mysql

# MySQL DSN (Go mysql driver format)
# 示例（本机 MySQL）：
# MYSQL_DSN=ops_user:ops_password@tcp(host.docker.internal:3306)/computility_ops?parseTime=true&loc=Local&charset=utf8mb4
MYSQL_DSN=root:root@tcp(host.docker.internal:3306)/computility_ops?parseTime=true&loc=Local&charset=utf8mb4

# backend listen addr in container
APP_ADDR=:8080

# audit log path in container
AUDIT_LOG_PATH=/var/log/computility/audit.log

# meta import job auto-clean policy
# 清理多少天前已结束任务（done/failed）
META_IMPORT_CLEAN_DAYS=7
# 清理时至少保留最近多少条任务
META_IMPORT_KEEP_LATEST=200
